{
  "name": "schoolconnect",
  "version": "0.1.0",
  "private": true,
  "description": "SchoolConnect — school consent & event reminder platform (MVP). Phase 1: tenant + staff auth foundation.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.20",
    "@types/react": "19.2.2",
    "prisma": "5.22.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
