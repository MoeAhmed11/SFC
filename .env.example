# ConsaPass environment variables — NAMES AND SAFE PLACEHOLDERS ONLY.
# Never commit real secrets. Copy this file to `.env` and fill in local values.

# --- Database ---------------------------------------------------------------
# Local dev/test uses SQLite (no DB server required in this environment).
# Production target is PostgreSQL; switch the provider in prisma/schema.prisma
# and use a postgresql:// URL, e.g. postgresql://user:password@localhost:5432/consapass
DATABASE_URL="file:./dev.db"

# --- Session / auth ---------------------------------------------------------
# 32+ byte random secret used to sign/verify staff session tokens.
# Generate locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS="28800"

# --- Email (spec decision 17.8: provider/domain kept configurable) ---------
# "mock" (default) sends nothing and is safe for dev/tests.
# "resend" sends real email via https://resend.com — requires RESEND_API_KEY
# and EMAIL_FROM below (a verified sending domain). "smtp" is documented but
# not implemented — Resend was selected instead, see PILOT_READINESS.md.
# See src/server/notifications/EmailProviderConfig.ts.
EMAIL_PROVIDER="mock"

# Required only when EMAIL_PROVIDER="resend". Get a key from the Resend
# dashboard (https://resend.com/api-keys). Never commit a real value.
RESEND_API_KEY=""

# Required only when EMAIL_PROVIDER="resend". Must be an address on a domain
# verified in Resend (SPF/DKIM configured) — consapass.co.uk is the confirmed
# sending domain, e.g.:
# EMAIL_FROM="ConsaPass <no-reply@consapass.co.uk>"
EMAIL_FROM=""

# --- App --------------------------------------------------------------------
NODE_ENV="development"

# Base URL used to build links that go outside the app (staff invite links,
# parent secure links). Locally this stays on localhost; production uses the
# confirmed domain (https://consapass.co.uk) once deployed — see HOSTING.md.
APP_BASE_URL="http://localhost:3000"
