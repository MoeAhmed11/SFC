# SchoolConnect environment variables — NAMES AND SAFE PLACEHOLDERS ONLY.
# Never commit real secrets. Copy this file to `.env` and fill in local values.

# --- Database ---------------------------------------------------------------
# Local dev/test uses SQLite (no DB server required in this environment).
# Production target is PostgreSQL; switch the provider in prisma/schema.prisma
# and use a postgresql:// URL, e.g. postgresql://user:password@localhost:5432/schoolconnect
DATABASE_URL="file:./dev.db"

# --- Session / auth ---------------------------------------------------------
# 32+ byte random secret used to sign/verify staff session tokens.
# Generate locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS="28800"

# --- Email (spec decision 17.8: provider/domain kept configurable) ---------
# "mock" (default) sends nothing and is safe for dev/tests. Real provider
# adapters (smtp/resend) are not implemented yet — selecting one before it's
# built will fail loudly at startup rather than silently sending nothing. See
# src/server/notifications/EmailProviderConfig.ts.
EMAIL_PROVIDER="mock"

# --- App --------------------------------------------------------------------
NODE_ENV="development"

# Base URL used to build links that go outside the app (staff invite links,
# parent secure links) until a real deployment config exists.
APP_BASE_URL="http://localhost:3000"
